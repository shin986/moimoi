// ================================
// GitHub 版本檢查函式
// ================================
void checkGitHubVersion() {

  // 避免網路錯誤時每一圈 loop 都重新連線
  lastVersionCheck = millis();

  if (WiFi.status() != WL_CONNECTED) {
    versionStatus = "Wi-Fi 未連線，無法檢查";
    Serial.println(versionStatus);
    return;
  }

  WiFiClientSecure client;

  // 測試用：略過 HTTPS 憑證驗證
  // 正式使用建議設定 CA 憑證
  client.setInsecure();

  HTTPClient https;
  https.setTimeout(8000);

  Serial.println();
  Serial.println("正在檢查 GitHub 版本...");

  if (!https.begin(client, versionURL)) {
    versionStatus = "無法連接 GitHub";
    Serial.println(versionStatus);
    return;
  }

  // 避免取得快取的舊版本資料
  https.addHeader("Cache-Control", "no-cache");

  int httpCode = https.GET();

  if (httpCode == HTTP_CODE_OK) {

    String version = https.getString();
    version.trim();

    // 基本格式檢查
    bool valid = version.length() > 0 &&
                 version.length() <= 30;

    for (unsigned int i = 0; i < version.length(); i++) {
      char c = version.charAt(i);

      if (!((c >= '0' && c <= '9') ||
            c == '.')) {
        valid = false;
        break;
      }
    }

    if (valid) {
      latestVersion = version;

      if (latestVersion == currentVersion) {
        versionStatus = "✅ 目前已是最新版本";
      } else {
        versionStatus = "🆕 發現不同版本，請確認是否需要更新";
      }

      Serial.println("目前版本：" +
                     String(currentVersion));

      Serial.println("GitHub 最新版本：" +
                     latestVersion);

      Serial.println("版本狀態：" +
                     versionStatus);

    } else {
      versionStatus = "版本檔案格式錯誤";
      Serial.println(versionStatus);
    }

  } else {
    versionStatus = "GitHub 檢查失敗，HTTP：" +
                    String(httpCode);

    Serial.println(versionStatus);
  }

  https.end();
}

// ================================
// Setup
// ================================
void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println();
  Serial.println("================================");
  Serial.println("ESP32 韌體管理系統");
  Serial.println("目前版本：" + String(currentVersion));
  Serial.println("================================");

  // 連線 Wi-Fi
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("正在連接 Wi-Fi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");

  }

  Serial.println();
  Serial.println("Wi-Fi 連線成功！");
  Serial.print("IP 位址：http://");
  Serial.println(WiFi.localIP());

  // 設定 mDNS
  if (MDNS.begin(host)) {
    Serial.println("mDNS 已啟動");
    Serial.println("網址：http://esp32.local");
  } else {
    Serial.println("mDNS 啟動失敗，可使用 IP 位址連線");
  }

  // 開機自動檢查 GitHub 版本
  checkGitHubVersion();

  // 首頁：登入
  server.on("/", HTTP_GET, []() {
    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "text/html; charset=UTF-8",
                loginIndex);
  });

  // OTA 管理頁面
  server.on("/serverIndex", HTTP_GET, []() {
    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "text/html; charset=UTF-8",
                serverIndex);
  });

  // 提供目前版本資訊
  server.on("/version", HTTP_GET, []() {
    String json = "{";
    json += "\"current\":\"" +
            String(currentVersion) + "\",";
    json += "\"latest\":\"" +
            latestVersion + "\",";
    json += "\"status\":\"" +
            versionStatus + "\"";
    json += "}";

    server.sendHeader("Cache-Control", "no-store");
    server.send(200, "application/json; charset=UTF-8",
                json);
  });

  // 手動檢查 GitHub 版本
  server.on("/checkVersion", HTTP_GET, []() {
    checkGitHubVersion();

    server.send(200, "text/plain; charset=UTF-8",
                versionStatus);
  });

  // OTA 更新結果
  server.on("/update", HTTP_POST, []() {

    server.sendHeader("Connection", "close");

    if (Update.hasError()) {
      server.send(500, "text/plain", "FAIL");
    } else {
      server.send(200, "text/plain", "OK");
      delay(500);
      ESP.restart();
    }

  }, []() {

    HTTPUpload& upload = server.upload();

    if (upload.status == UPLOAD_FILE_START) {

      Serial.printf("開始更新：%s\n",
                    upload.filename.c_str());

      if (!Update.begin(UPDATE_SIZE_UNKNOWN)) {
        Update.printError(Serial);
      }

    } else if (upload.status == UPLOAD_FILE_WRITE) {

      size_t written = Update.write(
        upload.buf,
        upload.currentSize
      );

      if (written != upload.currentSize) {
        Update.printError(Serial);
      }

    } else if (upload.status == UPLOAD_FILE_END) {

      if (Update.end(true)) {
        Serial.printf(
          "更新成功：%u bytes\n",
          upload.totalSize
        );
        Serial.println("準備重新啟動...");
      } else {
        Update.printError(Serial);
      }

    } else if (upload.status == UPLOAD_FILE_ABORTED) {

      Update.abort();
      Serial.println("更新已中止");
    }
  });

  // 啟動伺服器
  server.begin();

  Serial.println("Web Server 已啟動");
  Serial.println("版本：" + String(currentVersion));
  Serial.println("================================");
}

// ================================
// Loop
// ================================
void loop() {

  server.handleClient();

  // 定時檢查 GitHub 最新版本
  if (millis() - lastVersionCheck >=
      versionCheckInterval) {

    checkGitHubVersion();
  }

  delay(2);
}
